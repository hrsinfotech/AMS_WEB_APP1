FROM node:22-alpine AS build

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.24.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY artifacts/hrs-tech-dashboard/package.json ./artifacts/hrs-tech-dashboard/package.json
COPY lib ./lib
COPY artifacts/hrs-tech-dashboard ./artifacts/hrs-tech-dashboard
ARG VITE_API_URL=http://localhost:8084
ENV NODE_ENV=production
ENV PORT=8085
ENV BASE_PATH=/
ENV VITE_API_URL=${VITE_API_URL}
RUN pnpm install --frozen-lockfile --allow-build=esbuild && pnpm --filter @workspace/hrs-tech-dashboard run build

FROM nginx:1.27-alpine
COPY --from=build /app/artifacts/hrs-tech-dashboard/dist/public /usr/share/nginx/html
EXPOSE 80